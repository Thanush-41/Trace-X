# Optional locally (defaults to file:tracex.db). Required on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Replace the demo sign-in accounts and session key for any shared deployment.
# TRACEX_USERS is a JSON array of {username,password,name,role}; role is analyst or admin.
TRACEX_USERS=
TRACEX_SESSION_SECRET=

# Optional credentials used by `npm run smoke` (defaults to the demo admin account).
TRACEX_SMOKE_USER=
TRACEX_SMOKE_PASSWORD=
